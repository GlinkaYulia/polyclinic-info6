# Скопіюйте цей файл у .env та заповніть значення (файл .env не комітити!)
DATABASE_URL=postgres://postgres:ВАШ_ПАРОЛЬ@localhost:5432/polyclinic
PORT=4567
# Згенеруйте командою: ruby -rsecurerandom -e 'puts SecureRandom.hex(32)'
SESSION_SECRET=ЗАМІНІТЬ_НА_ДОВГЕ_ВИПАДКОВЕ_ЗНАЧЕННЯ
# Необов'язково: токен для доступу до /api/metrics (або заходьте як admin)
METRICS_TOKEN=

# --- AI (лабораторна №6) ---
# mock — демо без ключа; gemini — Google AI; openai — OpenAI
AI_PROVIDER=mock
GEMINI_API_KEY=
# Перевірте актуальні назви моделей у документації Google AI
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=
